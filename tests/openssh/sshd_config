# sshd configuration of the OpenSSH test server (tests/openssh, README.md).
#
# Test use only. Three users, one authentication method each; the entrypoint
# creates them at container start with the credentials that start.sh
# generates for the run. The published port is bound to 127.0.0.1 only.

Port 22
AddressFamily inet
ListenAddress 0.0.0.0

# Generated by the entrypoint at container start.
HostKey /etc/ssh/ssh_host_ed25519_key
HostKey /etc/ssh/ssh_host_ecdsa_key
HostKey /etc/ssh/ssh_host_rsa_key

# sshd runs with -e: the log goes to the container output (docker logs).
LogLevel INFO

PermitRootLogin no
StrictModes yes
LoginGraceTime 60
MaxAuthTries 6
MaxSessions 10
MaxStartups 100
# Every connection reaches the container from the Docker gateway address, so
# per-source penalties (OpenSSH 9.8 and later) would throttle the whole suite
# after the failed attempts that the tests make on purpose.
PerSourcePenalties no
UseDNS no

# Password and keyboard-interactive authentication go through PAM (pam_unix);
# keyboard-interactive asks one question, the password, without echo.
UsePAM yes
PubkeyAuthentication yes
PasswordAuthentication yes
KbdInteractiveAuthentication yes
PermitEmptyPasswords no
HostbasedAuthentication no
IgnoreRhosts yes
AuthorizedKeysFile .ssh/authorized_keys

# Agent forwarding (stage 2), TCP forwarding and SFTP (later stages).
AllowAgentForwarding yes
AllowTcpForwarding yes
AllowStreamLocalForwarding no
GatewayPorts no
X11Forwarding no
PermitTunnel no
PermitUserEnvironment no
# Environment requests: the locale variables and test variables named SHELLPP_*.
AcceptEnv LANG LC_* SHELLPP_*
Subsystem sftp internal-sftp

# PAM prints the message of the day.
PrintMotd no
PrintLastLog no

AllowUsers pwuser keyuser kiuser

Match User pwuser
    AuthenticationMethods password

Match User keyuser
    AuthenticationMethods publickey

Match User kiuser
    AuthenticationMethods keyboard-interactive
