{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "All local app windows (labels w-*): the app commands (stage 2), events and title bar window controls. core:default is not granted (docs/security.md, section 13.2).",
  "windows": [
    "w-*"
  ],
  "platforms": [
    "windows",
    "macOS",
    "linux"
  ],
  "local": true,
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-set-fullscreen",
    "allow-app-info",
    "allow-state-snapshot",
    "allow-window-open",
    "allow-activity",
    "allow-app-exit",
    "allow-window-close",
    "allow-external-open-url",
    "allow-lock-status",
    "allow-first-run-setup",
    "allow-unlock",
    "allow-lock",
    "allow-recovery-unlock",
    "allow-password-change",
    "allow-recovery-key-show",
    "allow-recovery-key-reissue",
    "allow-remember-device-set",
    "allow-records-query",
    "allow-record-get",
    "allow-record-save",
    "allow-record-delete",
    "allow-record-restore",
    "allow-record-move",
    "allow-record-duplicate",
    "allow-secret-reveal",
    "allow-secret-copy",
    "allow-settings-get",
    "allow-settings-set",
    "allow-notifications-list",
    "allow-notifications-mark-read",
    "allow-clipboard-write-text",
    "allow-clipboard-read-text",
    "allow-session-open",
    "allow-session-attach",
    "allow-session-write",
    "allow-session-inject",
    "allow-session-resize",
    "allow-session-prompt-reply",
    "allow-session-cancel",
    "allow-session-close",
    "allow-session-reconnect",
    "allow-session-ack",
    "allow-local-shells",
    "allow-local-open",
    "allow-known-hosts-list",
    "allow-known-host-remove",
    "allow-keys-list",
    "allow-key-import",
    "allow-history-list",
    "allow-history-delete",
    "allow-history-clear",
    "allow-recent-connections"
  ]
}
