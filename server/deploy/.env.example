# Copy to .env next to docker-compose.yml and fill in. Never commit .env.
#
# A long random database password:  openssl rand -base64 32
POSTGRES_PASSWORD=
# The https origin your devices use, exactly as typed in the app.
SHELLPP_PUBLIC_URL=https://sync.example.com
# At least 32 random bytes, base64:  openssl rand -base64 48
# It derives the server-only keys; keep it with your backups' private key.
SHELLPP_SERVER_SECRET=
# invite (default: accounts only with a code from `admin user invite`) or open.
SHELLPP_REGISTRATION=invite
# The one address whose X-Forwarded-For the server believes, so the rate
# limits see each client's address. A proxy on the host (Caddy, cloudflared)
# reaches the server from the gateway of the compose network; a proxy
# container on that network: its fixed address instead (README, "Client
# addresses"). Never a whole range: anyone inside it could name any client.
SHELLPP_TRUSTED_PROXIES=172.16.88.1/32
# The subnet of the compose network and its gateway; change them together
# with SHELLPP_TRUSTED_PROXIES only if 172.16.88.0/24 is taken here.
#SHELLPP_SUBNET=172.16.88.0/24
#SHELLPP_GATEWAY=172.16.88.1
# The age public key the daily backups are encrypted to (age-keygen); the
# private key stays OFF this machine.
BACKUP_AGE_RECIPIENT=
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
