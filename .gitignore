# ---------------------------------------------------------------------------
# Secrets: never commit these. Tests generate keys and passwords at runtime.
# ---------------------------------------------------------------------------
*.pem
*.key
*.ppk
id_rsa*
id_ed25519*
id_ecdsa*
.env*
known_hosts
known_hosts.*
# Source module of the known hosts store (not a key file).
!/crates/core/src/known_hosts/
*.p12
*.pfx
*.keystore
*.jks

# ---------------------------------------------------------------------------
# Rust
# ---------------------------------------------------------------------------
/target/
**/target/
**/*.rs.bk
*.pdb
# Cargo.lock is committed (the workspace builds applications).

# ---------------------------------------------------------------------------
# Node / TypeScript
# ---------------------------------------------------------------------------
node_modules/
.pnpm-store/
dist/
dist-ssr/
build/
out/
coverage/
.nyc_output/
*.tsbuildinfo
.eslintcache
.vite/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ---------------------------------------------------------------------------
# Tauri
# ---------------------------------------------------------------------------
**/src-tauri/target/
**/src-tauri/gen/schemas/
**/src-tauri/WixTools/
# Mobile projects generated by `tauri android|ios init` keep their own ignores.
**/src-tauri/gen/android/.gradle/
**/src-tauri/gen/android/**/build/
**/src-tauri/gen/apple/build/
**/src-tauri/gen/apple/**/xcuserdata/

# ---------------------------------------------------------------------------
# Test artifacts
# ---------------------------------------------------------------------------
test-results/
playwright-report/
allure-results/
allure-report/
wdio-logs/
*.log
*.sqlite-journal
*.db-journal
*.db-wal
*.db-shm

# ---------------------------------------------------------------------------
# IDEs and editors
# ---------------------------------------------------------------------------
.idea/
*.iml
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json
.fleet/
.zed/
*.swp
*.swo
*~
\#*\#
.\#*
*.sublime-project
*.sublime-workspace

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Linux
.directory
.Trash-*
.nfs*
