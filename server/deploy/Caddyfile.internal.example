# Access 3: only over your VPN, with Caddy's internal CA (server/README.md).
# Every device adds Caddy's root certificate (pki/authorities/local/root.crt
# in Caddy's data directory) with "Add a CA certificate..." when it first
# connects; renewed certificates of that CA then need no question.
sync.home.arpa {
	tls internal
	reverse_proxy 127.0.0.1:8080
}
